# ProxyScrape proxy settings
# Copy this file to .env and fill in your credentials. .env is gitignored.
# Credentials come from the ProxyScrape dashboard: Residential > Proxy Setup.

# Set to true to route crawls through the proxy by default.
# The --proxy / --no-proxy flags override this per run.
PROXY_ENABLED=true

PROXYSCRAPE_USERNAME=your-username
PROXYSCRAPE_PASSWORD=your-password

# Residential endpoint. Change only if your dashboard shows a different one
# (e.g. a datacenter or mobile endpoint).
PROXYSCRAPE_HOST=rp.scrapegw.com
PROXYSCRAPE_PORT=6060
PROXYSCRAPE_PROTOCOL=http

# Optional country targeting for exit nodes, e.g. us, gb, de. Leave blank for any.
PROXYSCRAPE_COUNTRY=

# 1 = use the rotating endpoint (fresh IP per request). This is the right
# default for crawling many pages of one site.
# >1 = open that many sticky sessions and rotate through them.
PROXYSCRAPE_SESSIONS=1

# How long a sticky session keeps its IP, in minutes (1-120).
PROXYSCRAPE_SESSION_LIFETIME=10
